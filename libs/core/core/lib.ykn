public load .ast: ClaritySchema, CommandDef, FlagDef, ParamDef, GroupDef, ValidatorDef, AppMeta
public load .errors: ClarityError, clarity_error, format_clarity_error
public load .lexer: Lexer, Token
public load .parser: Parser
public load .semantic: SemanticValidator
public load .bytecode: ByteBuffer, compile_schema_hex, write_bytecode_bin
public load .codegen: CodeGenerator, generate_code

public fun parse_schema(src: string) -> ClaritySchema {
    set p: Parser = init Parser(src)
    set schema: ClaritySchema = p.parse_schema()
    set validator: SemanticValidator = init SemanticValidator()
    validator.validate(ref schema)
    return schema
}

public fun compile_schema_to_bytecode(src: string) -> ByteBuffer {
    set schema: ClaritySchema = parse_schema(src)
    set hex: string = compile_schema_hex(ref schema)
    return init ByteBuffer(hex)
}

public fun compile_schema_to_code(src: string) -> string {
    set schema: ClaritySchema = parse_schema(src)
    set hex: string = compile_schema_hex(ref schema)
    set bc_buf: ByteBuffer = init ByteBuffer(hex)
    set gen: CodeGenerator = init CodeGenerator(schema)
    return gen.generate(ref bc_buf)
}

public fun compile_schema_to_code_file(src: string, out_bin_path: string, rel_include_path: string) -> string {
    set schema: ClaritySchema = parse_schema(src)
    set hex: string = compile_schema_hex(ref schema)
    set _ = write_bytecode_bin(out_bin_path, hex)
    set gen: CodeGenerator = init CodeGenerator(schema)
    return gen.generate_with_path(rel_include_path)
}
