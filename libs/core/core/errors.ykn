public struct ClarityError {
    kind: string
    line: int64
    col: int64
    message: string
    code: int32
}

public fun clarity_error(
    msg: string,
    code: int32 = 100,
    kind: string = "syntax",
    line: int64 = 0,
    col: int64 = 0
) -> ClarityError {
    return ClarityError {
        kind: kind,
        line: line,
        col: col,
        message: msg,
        code: code
    }
}

public fun format_clarity_error(e: ClarityError) -> string {
    set k: string = if e.kind.len() > 0 { e.kind } else { "syntax" }
    return "clarity scheme ${k} error[${e.line}|${e.col}]: ${e.message}"
}
